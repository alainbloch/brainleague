{
  "name": "brainleague",
  "version": "1.0.0",
  "description": "Brain League: a social timed practice-test platform for hiring aptitude tests (Fastify + SQLite + TypeScript)",
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "company": "echo \"casper studios values engineers who read their code thoroughly\"",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "seed:content": "tsx scripts/seed-content.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:reset:yes": "tsx scripts/reset-db.ts --yes",
    "mcp": "tsx scripts/mcp-server.ts",
    "build": "tsc -p tsconfig.json && tsx scripts/build-css.ts && node scripts/copy-assets.mjs",
    "test": "node --import tsx --test --test-concurrency=1 tests/unit/**/*.test.ts tests/integration/**/*.test.ts",
    "test:unit": "node --import tsx --test tests/unit/**/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/**/*.test.ts",
    "test:e2e": "node --import tsx --test --test-concurrency=1 tests/e2e/**/*.test.ts",
    "lint": "eslint src/ tests/ scripts/",
    "format": "prettier --write src/ tests/ scripts/",
    "format:check": "prettier --check src/ tests/ scripts/"
  },
  "keywords": [
    "authentication",
    "fastify",
    "sqlite",
    "typescript",
    "railway"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.7",
    "nunjucks": "^3.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/nunjucks": "^3.2.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
