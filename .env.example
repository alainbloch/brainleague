# Copy to .env and fill in. NEVER commit real values.
# -----------------------------------------------------

# Server
PORT=3000

# SQLite database file path. On Railway, mount a volume at /app/data
# and set DATABASE_PATH=/app/data/app.db so data persists.
DATABASE_PATH=./data/app.db

# Avatar upload directory (also on the Railway volume in production).
UPLOAD_DIR=./data/uploads

# Secrets (generate with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
# Used to sign/verify the in-memory session store and CSRF-adjacent ops.
SESSION_SECRET=change-me-to-a-long-random-string

# Base URL of the deployed app (used in verification/reset magic links).
APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# MCP agent endpoint (Streamable HTTP at /mcp). Off by default. Enable only if
# you intend to let an MCP client (Claude Desktop, Cursor, agent CLIs) drive the
# app over HTTP. Tool calls still require a sessionToken minted by the
# `authenticate` tool; this only exposes the transport, not anonymous access.
# MCP_HTTP_ENABLED=true