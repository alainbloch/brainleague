{% extends "layouts/base.njk" %}
{% import "components/forms.njk" as forms %}

{% block content %}
<div class="mx-auto max-w-md">
  <section class="auth-card">
    <h1 class="auth-heading mb-4">{{ pageTitle }}</h1>
    <div class="mb-4">{{ forms.alert(message, "ok") }}</div>
    <div class="mt-6 text-sm">
      <a href="/login" class="{{ ui.buttonClass('primary', 'sm') }}">Go to sign in</a>
    </div>
  </section>
</div>
{% endblock %}
