{% extends "layouts/base.njk" %}
{% import "components/forms.njk" as forms %}

{% block content %}
<div class="mx-auto max-w-md">
  <section class="{{ ui.cardClass }}">
    <h2 class="font-heading text-base font-semibold mb-4">Reset password</h2>
    {% if error %}
      <div class="mb-4">{{ forms.alert(error, "danger") }}</div>
    {% endif %}
    <form method="post" action="/auth/reset" class="grid gap-4">
      <input type="hidden" name="token" value="{{ values.token }}" />
      {{ forms.field("email", "Email", { type: "email", value: values.email, autocomplete: "email", required: true }) }}
      {{ forms.field("password", "New password", { type: "password", hint: "8–128 characters.", autocomplete: "new-password", required: true }) }}
      {{ forms.field("passwordConfirm", "Repeat password", { type: "password", autocomplete: "new-password", required: true }) }}
      <button type="submit" class="mt-2 w-full {{ ui.buttonClass('primary', 'md') }}">Update password</button>
    </form>
  </section>
</div>
{% endblock %}
