{% extends "layouts/base.njk" %}
{% import "components/forms.njk" as forms %}

{% block content %}
<div class="mx-auto max-w-md">
  <section class="{{ ui.cardClass }}">
    <h2 class="font-heading text-base font-semibold mb-4">Create account</h2>
    {% if error %}
      <div class="mb-4">{{ forms.alert(error, "danger") }}</div>
    {% endif %}
    <form method="post" action="/register" class="grid gap-4">
      {{ forms.field("name", "Name", { value: values.name, autocomplete: "name", required: true }) }}
      {{ forms.field("email", "Email", { type: "email", value: values.email, autocomplete: "email", required: true }) }}
      {{ forms.field("password", "Password", { type: "password", hint: "8–128 characters.", autocomplete: "new-password", required: true }) }}
      <button type="submit" class="mt-2 w-full {{ ui.buttonClass('primary', 'md') }}">Create account</button>
    </form>
    <p class="mt-6 text-center text-sm text-muted">Already have an account? <a href="/login" class="text-ink hover:text-ink underline-offset-4 hover:underline">Sign in</a></p>
  </section>
</div>
{% endblock %}
