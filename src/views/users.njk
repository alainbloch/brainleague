{% extends "layouts/base.njk" %}
{% from "components/page.njk" import heading, empty %}
{% from "components/home-graphics.njk" import graphic %}
{% import "components/forms.njk" as forms %}

{% block content %}
<div class="grid gap-6">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div class="grid gap-1">
      <h1 class="page-title font-heading text-2xl font-semibold text-ink">Find your crew</h1>
      <p class="text-sm text-muted">{{ directory.total }} members · A little competition is better with friends</p>
    </div>
    <form method="get" action="/users" class="directory-search">
      <input type="search" name="q" value="{{ q }}" placeholder="Search by name or email"
        class="{{ ui.inputClass }}" aria-label="Search users" />
      <button type="submit" class="{{ ui.buttonClass('secondary', 'md') }}">Search</button>
    </form>
  </header>

  {% if error %}
    <div class="mb-4">{{ forms.alert(error, "danger") }}</div>
  {% endif %}

  {% if directory.users.length === 0 %}
    {{ empty('No matches this time', 'Try a different name or browse everyone in the league.', '/users', 'Browse members', 'podium') }}
  {% else %}
    <div class="grid gap-3 sm:grid-cols-2">
      {% for member in directory.users %}
        <a href="/users/{{ member.id }}"
          class="{{ ui.cardClass }} interactive-card flex items-center gap-4">
          {% if member.avatarPath %}
            <img src="/uploads/{{ member.avatarPath }}" alt="{{ member.name }}"
              class="avatar size-11 rounded-pill object-cover border border-edge" />
          {% else %}
            <span class="avatar inline-flex size-11 shrink-0 items-center justify-center rounded-pill bg-raised text-ink-soft font-semibold">{{ ui.initials(member.name) }}</span>
          {% endif %}
          <span class="min-w-0 grid gap-0.5">
            <span class="flex items-center gap-2 text-sm font-medium">
              {{ member.name }}
              {% if member.role === 'admin' %}<span class="{{ ui.badgeClass('accent') }}">Admin</span>{% endif %}
            </span>
            <span class="truncate text-xs text-muted">{{ member.email }}</span>
          </span>
        </a>
      {% endfor %}
    </div>

    {% if directory.pages > 1 %}
      <nav class="flex items-center justify-between text-sm" aria-label="Pagination">
        <div class="text-muted">
          Page {{ directory.page }} of {{ directory.pages }}
        </div>
        <div class="flex items-center gap-2">
          {% if directory.page > 1 %}
            <a href="/users?q={{ q }}&page={{ directory.page - 1 }}" class="{{ ui.buttonClass('secondary', 'sm') }}">Previous</a>
          {% endif %}
          {% if directory.page < directory.pages %}
            <a href="/users?q={{ q }}&page={{ directory.page + 1 }}" class="{{ ui.buttonClass('secondary', 'sm') }}">Next</a>
          {% endif %}
        </div>
      </nav>
    {% endif %}
  {% endif %}
</div>
{% endblock %}
