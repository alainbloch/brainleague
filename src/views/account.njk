{% extends "layouts/base.njk" %}
{% from "components/page.njk" import heading, empty %}
{% from "components/home-graphics.njk" import graphic %}
{% import "components/forms.njk" as forms %}

{% block content %}
<div class="grid gap-6">
  <section class="{{ ui.cardClass }} profile-header">
    <div class="flex flex-wrap items-center gap-4">
      {% if user.avatarPath %}
        <img src="/uploads/{{ user.avatarPath }}" alt="{{ user.name }}"
          class="avatar profile-avatar size-14 rounded-pill object-cover border border-edge" />
      {% else %}
        <span class="avatar profile-avatar inline-flex size-14 items-center justify-center rounded-pill bg-raised text-ink-soft font-semibold">{{ user.name | first | upper }}</span>
      {% endif %}
      <div class="min-w-0 grid gap-1">
        <h1 class="page-title font-heading text-2xl font-semibold text-ink">{{ user.name }}</h1>
        <p class="text-sm text-muted">{{ user.email }}</p>
      </div>
      <div class="profile-actions ml-auto flex items-center gap-3 text-sm">
        <span class="{{ ui.badgeClass('ok') }}">Verified</span>
        <a href="/settings" class="{{ ui.buttonClass('secondary', 'md') }}">Settings</a>
        <a href="/logout" class="{{ ui.buttonClass('tertiary', 'md') }}">Sign out</a>
      </div>
    </div>
  </section>
  <div class="card-grid"><a href="/tests" class="{{ ui.cardClass }} interactive-card">{{ graphic("tests") }}<h2 class="text-xl font-semibold">Your next challenge</h2><p class="page-description">Make a little time for your next personal best.</p></a><a href="/users/{{ user.id }}" class="{{ ui.cardClass }} interactive-card">{{ graphic("podium") }}<h2 class="text-xl font-semibold">Your league profile</h2><p class="page-description">See your profile and catch up with your crew.</p></a></div>
</div>
{% endblock %}
