{% extends "layouts/base.njk" %}
{% from "components/page.njk" import heading, empty %}
{% from "components/home-graphics.njk" import graphic %}

{% block content %}
<div class="page-stack">
  {{ heading("Leaderboards", "A personal best, a friendly rivalry, and plenty of reasons to cheer each other on.", "podium") }}

  {% if not tests.length %}
    {{ empty('Every league starts somewhere', 'Choose a challenge and set a score for friends to chase.', '/tests', 'Find a challenge', 'podium') }}
  {% else %}
    <ul class="grid gap-3">
      {% for test in tests %}
        <li class="{{ ui.cardClass }} flex flex-wrap items-center justify-between gap-4">
          <div class="min-w-0">
            <h2 class="font-heading text-base font-semibold text-ink">{{ test.name }}</h2>
            <p class="text-xs text-muted">{{ test.questionCount }} questions · {{ (test.durationSeconds / 60) | round(0, 'floor') }} min</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a href="/tests/{{ test.slug }}/leaderboard" class="{{ ui.buttonClass('primary', 'sm') }}">Global</a>
            <a href="/tests/{{ test.slug }}/leaderboard/friends" class="{{ ui.buttonClass('secondary', 'sm') }}">Friends</a>
          </div>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>
{% endblock %}