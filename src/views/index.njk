{% extends "layouts/base.njk" %}

{% block content %}
<div class="grid gap-10">
  {# Hero -- a friendly, competitive brain-test pitch: beat your friends, not the clock alone. #}
  <section class="mx-auto grid max-w-2xl gap-4 text-center">
    <p class="text-xs font-semibold uppercase tracking-widest text-accent">Timed brain tests, made for friendly rivalry</p>
    <h1 class="font-heading text-4xl font-bold leading-tight text-ink sm:text-5xl">
      Who's the quickest mind in your crew?
    </h1>
    <p class="mx-auto max-w-xl text-sm leading-relaxed text-muted">
      Answer as many questions as you can before the clock runs out, then see how you
      stack up against your friends on the leaderboard. Every test is real format, real
      pace — built so quick thinking and knowing the question types beat grinding. Take a
      round, get your score, and one-up your crew.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      {% if tests.length %}
        <a href="/tests/{{ tests[0].slug }}/take">
          <button type="button" class="{{ ui.buttonClass('primary', 'md') }}">Challenge your friends →</button>
        </a>
      {% endif %}
      <a href="/tests">
        <button type="button" class="{{ ui.buttonClass('secondary', 'md') }}">Browse all tests</button>
      </a>
    </div>
  </section>

  {# Test catalog cards. #}
  <section class="grid gap-4">
    <h2 class="font-heading text-xl font-semibold text-ink">Pick a brain test and go head-to-head</h2>
    {% if not tests.length %}
      <p class="text-sm text-muted">No practice tests are available yet. Check back soon.</p>
    {% else %}
      <div class="grid gap-4 sm:grid-cols-2">
        {% for test in tests %}
          <section class="{{ ui.cardClass }}">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <h3 class="font-heading text-lg font-semibold text-ink">{{ test.name }}</h3>
                <p class="text-xs text-muted">by {{ test.publisher }}</p>
              </div>
              {% if test.noGoingBack %}
                <span class="{{ ui.badgeClass('info') }}">No going back</span>
              {% endif %}
            </div>
            <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
              <div>
                <span class="block text-xs text-muted">Questions</span>
                <span class="font-medium text-ink">{{ test.questionCount }}</span>
              </div>
              <div>
                <span class="block text-xs text-muted">Time</span>
                <span class="font-medium text-ink">{{ (test.durationSeconds / 60) | round(0, 'floor') }} min</span>
              </div>
            </dl>
            <div class="mt-5 flex flex-wrap gap-2">
              <a href="/tests/{{ test.slug }}/take">
                <button type="button" class="{{ ui.buttonClass('primary', 'md') }}">Take the test</button>
              </a>
              <a href="/tests/{{ test.slug }}/leaderboard">
                <button type="button" class="{{ ui.buttonClass('secondary', 'md') }}">Leaderboard</button>
              </a>
            </div>
          </section>
        {% endfor %}
      </div>
    {% endif %}
  </section>

  {# How it works + value props. #}
  <section class="grid gap-4 sm:grid-cols-3">
    {% for feature in [
      { title: "Real pace, real pressure", body: "Practice at test speed so the clock feels familiar — out-answer your friends where it counts." },
      { title: "Learn the question types", body: "Get tips on spotting analogies, word problems, number series and more before they eat your time." },
      { title: "Compete with your crew", body: "Friend leaderboards and score alerts turn solo prep into a running battle with the people you know." }
    ] %}
      <section class="{{ ui.cardClass }}">
        <h4 class="font-heading text-sm font-semibold text-ink">{{ feature.title }}</h4>
        <p class="mt-1 text-sm text-muted">{{ feature.body }}</p>
      </section>
    {% endfor %}
  </section>
</div>
{% endblock %}