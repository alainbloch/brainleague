{% extends "layouts/base.njk" %}
{% from "components/page.njk" import heading, empty %}
{% from "components/home-graphics.njk" import graphic %}
{% import "components/forms.njk" as forms %}

{% block content %}
<div class="grid gap-6">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <h1 class="page-title font-heading text-2xl font-semibold text-ink">Notifications</h1>
    {% if notifications.length %}
      <form method="post" action="/notifications/read">
        <button type="submit" class="{{ ui.buttonClass('secondary', 'sm') }}">Mark all as read</button>
      </form>
    {% endif %}
  </header>

  {% if notifications.length === 0 %}
    {{ empty('All caught up', 'Friend requests and new scores will appear here. In the meantime, find your next challenge.', '/tests', 'Explore challenges', 'podium') }}
  {% else %}
    <ul class="grid gap-3">
      {% for item in notifications %}
        <li class="{{ ui.cardClass }} notification-item flex items-start gap-3 {{ 'opacity-70' if item.readAt else '' }}">
          {% if item.type === 'friend-request' %}
            <span class="notification-icon">{{ ui.icon("bell", { size: 20 }) }}</span>
          {% elif item.type === 'friend-accepted' %}
            <span class="notification-icon">{{ ui.icon("bell", { size: 20 }) }}</span>
          {% elif item.type === 'friend-score' %}
            <span class="notification-icon">{{ ui.icon("bell", { size: 20 }) }}</span>
          {% else %}
            <span class="notification-icon">{{ ui.icon("bell", { size: 20 }) }}</span>
          {% endif %}
          <div class="min-w-0 grid gap-0.5 text-sm">
            {% if item.type === 'friend-request' %}
              <p class="text-ink">
                <a href="/users/{{ item.payload.requesterId }}" class="font-medium underline-offset-4 hover:underline">
                  {{ item.payload.requesterName | default('Someone') }}
                </a>
                sent you a friend request.
              </p>
              <p class="text-xs text-muted">{{ ui.relativeDate(item.createdAt) }} · <a href="/users/{{ item.payload.requesterId }}" class="underline-offset-4 hover:underline">View profile</a></p>
            {% elif item.type === 'friend-accepted' %}
              <p class="text-ink">
                <a href="/users/{{ item.payload.friendId }}" class="font-medium underline-offset-4 hover:underline">
                  {{ item.payload.friendName | default('Someone') }}
                </a>
                accepted your friend request.
              </p>
              <p class="text-xs text-muted">{{ ui.relativeDate(item.createdAt) }}</p>
            {% elif item.type === 'friend-score' %}
              <p class="text-ink">
                <a href="/users/{{ item.payload.userId | default('') }}" class="font-medium underline-offset-4 hover:underline">
                  {{ item.payload.userName | default('A friend') }}
                </a>
                scored {{ item.payload.correctCount }}/{{ item.payload.totalQuestions }} on
                {{ item.payload.testTypeName | default('a timed test') }}.
              </p>
              <p class="text-xs text-muted">
                {{ ui.relativeDate(item.createdAt) }} ·
                <a href="/tests/{{ item.payload.testTypeSlug | default('') }}/leaderboard" class="underline-offset-4 hover:underline">Watch the leaderboard</a>
              </p>
            {% else %}
              <p class="text-ink">{{ item.payload.message | default('You have a new notification.') }}</p>
              <p class="text-xs text-muted">{{ ui.relativeDate(item.createdAt) }}</p>
            {% endif %}
          </div>
          {% if not item.readAt %}
            <span class="ml-auto mt-1 size-2 shrink-0 rounded-pill bg-accent" aria-label="Unread"></span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>
{% endblock %}