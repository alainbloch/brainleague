{% extends "layouts/base.njk" %}

{% block content %}
<div class="quiz-shell grid gap-6">
  <header class="quiz-status grid gap-3">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h1 class="page-title font-heading text-xl font-semibold text-ink">Your brain workout</h1>
        <p id="quiz-progress-label" class="text-sm text-muted" aria-live="polite">Question <span id="progress-current">1</span> of {{ questions.length }}</p>
      </div>
      <div class="quiz-clock text-right">
        <span id="timer-label" class="block text-xs text-muted">Time remaining</span>
        <span id="timer" class="text-xl font-semibold text-ink tabular-nums" role="timer">--:--</span>
      </div>
    </div>
    <progress id="quiz-progress" class="quiz-progress" max="{{ questions.length }}" value="0" aria-label="Questions completed"></progress>
    <p class="text-sm text-muted">Select an answer, then choose Next. Use keys <strong>1–4</strong> to select and <strong>Enter</strong> to continue. You cannot go back.</p>
  </header>

  <section class="{{ ui.cardClass }}">
    <div id="quiz" class="grid gap-6">
      {% for q in questions %}
        <section class="question-view" hidden data-question-id="{{ q.id }}" aria-labelledby="question-{{ loop.index0 }}">
          <p class="text-xs text-muted mb-2">{{ q.categorySlug | replace('-', ' ') }} · Typical solve time ~{{ q.estSeconds }}s</p>
          <h2 id="question-{{ loop.index0 }}" tabindex="-1" class="font-heading text-xl font-medium text-ink leading-snug">{{ q.visual.prompt if q.visual else q.prompt }}</h2>
          {% if q.visual %}
            <figure class="reasoning-diagram" role="img" aria-label="{{ q.visual.description }}">{{ q.visual.svg | safe }}</figure>
            <details class="text-sm text-muted mb-4"><summary>Text description</summary><p>{{ q.visual.description }}</p></details>
          {% endif %}
          <div class="answer-grid" role="group" aria-labelledby="question-{{ loop.index0 }}">
            {% for choice in q.choices %}
              <button type="button" class="answer-card choice" aria-pressed="false" aria-keyshortcuts="{{ loop.index }}" data-index="{{ loop.index0 }}">
                <span class="answer-key" aria-hidden="true">{{ loop.index }}</span>
                <span class="answer-content">
                  {% if q.visual and q.visual.choices[loop.index0] %}<span class="answer-diagram">{{ q.visual.choices[loop.index0] | safe }}</span>{% endif %}
                  <span>{{ choice }}</span>
                </span>
                <span class="answer-check" aria-hidden="true">✓</span>
              </button>
            {% endfor %}
          </div>
        </section>
      {% endfor %}
      <div class="quiz-actions">
        <button type="button" id="skip-btn" class="{{ ui.buttonClass('tertiary', 'md') }}">Skip question</button>
        <button type="button" id="next-btn" disabled class="{{ ui.buttonClass('primary', 'lg') }}">Next question →</button>
      </div>
      <p id="quiz-status" role="status" class="text-sm text-muted">Choose one answer to continue.</p>
    </div>
    <noscript>This timed test requires JavaScript. Enable it before starting a test.</noscript>
  </section>
</div>
{% include "quizzes/runner.njk" %}
{% endblock %}
