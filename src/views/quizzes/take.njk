{% extends "layouts/base.njk" %}

{% block content %}
<div class="page-stack quiz-shell">
  <div class="quiz-status flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="page-title font-heading text-xl font-semibold text-ink">Test in progress</h1>
      <p class="text-xs text-muted">Question <span id="progress-current">1</span> of <span id="progress-total">{{ questions.length }}</span></p>
    </div>
    <div class="flex items-center gap-3">
      <span class="{{ ui.badgeClass('neutral') }}" id="timer-label">Time</span>
      <span class="quiz-timer font-semibold text-ink" id="timer">--:--</span>
    </div>
  </div>

  <progress id="quiz-progress" class="quiz-progress" value="0" max="{{ questions.length }}" aria-label="Questions completed"></progress>
  <section class="{{ ui.cardClass }}">
    <div id="quiz" class="grid gap-6">
      {% for q in questions %}
        <div class="question-view hidden grid gap-5" data-question-id="{{ q.id }}" data-index="{{ loop.index0 }}">
          <div>
            <p class="text-xs text-muted mb-1">Q{{ loop.index }} · {{ q.categorySlug | replace('-', ' ') }}</p>
            <h2 class="font-heading text-2xl font-medium text-ink leading-snug">{{ q.prompt }}</h2>
            <p class="mt-1 text-xs text-muted">Typical solve time: ~{{ q.estSeconds }}s</p>
          </div>
          <div class="grid gap-2">
            {% for choice in q.choices %}
              <button type="button" class="choice text-left {{ ui.buttonClass('secondary', 'md') }}" data-index="{{ loop.index0 }}"><span class="choice-label" aria-hidden="true">{{ loop.index }}</span><span>{{ choice }}</span></button>
            {% endfor %}
          </div>
          <div class="flex justify-between">
            <button type="button" class="skip-btn {{ ui.buttonClass('tertiary', 'md') }}">Skip this question →</button>
          </div>
        </div>
      {% endfor %}
    </div>
  </section>
</div>

<script>
(function () {
  // Server-authoritative deadline (ms since epoch). Anchoring the countdown on
  // this server value keeps a skewed client clock from adding time.
  var deadlineMs = {{ deadlineMs }};
  var attemptId = "{{ attemptId }}";
  var views = Array.prototype.slice.call(document.querySelectorAll('.question-view'));
  var progressCurrent = document.getElementById('progress-current');
  var progressTotal = document.getElementById('progress-total');
  var timerEl = document.getElementById('timer');
  var timerLabel = document.getElementById('timer-label');
  var answered = []; // [{ questionId, chosenIndex, timeMs }]
  var idx = 0;
  var questionStart = Date.now();

  function fmt(ms) {
    if (ms <= 0) return '0:00';
    var totalSec = Math.ceil(ms / 1000);
    var m = Math.floor(totalSec / 60);
    var s = totalSec % 60;
    return m + ':' + (s < 10 ? '0' : '') + s;
  }

  function render() {
    views.forEach(function (v) { v.classList.add('hidden'); });
    if (idx >= views.length) { submit(); return; }
    var v = views[idx];
    v.classList.remove('hidden');
    questionStart = Date.now();
    progressCurrent.textContent = String(idx + 1);
    document.getElementById('quiz-progress').value = idx;
    progressTotal.textContent = String(views.length);
  }

  function advance(answer) {
    answered.push(answer);
    idx += 1;
    render();
    saveProgress();
  }

  // Persist answers to the server so an abandoned test can still be graded when
  // its deadline passes. Debounced gently; fire-and-forget, never blocks the UI.
  var saveTimer = null;
  function saveProgress() {
    var payload = JSON.stringify(answered);
    if (saveTimer) return; // coalesce bursts
    saveTimer = setTimeout(function () { saveTimer = null; }, 400);
    var fd = new FormData();
    fd.append('answers', payload);
    fetch('/tests/' + attemptId + '/progress', { method: 'POST', body: fd, credentials: 'same-origin' })
      .catch(function () { /* best-effort: submission is the authoritative path */ });
  }

  // Each view knows its own position; only the current view accepts input.
  // A skipped question records chosenIndex null and is final (no going back).
  views.forEach(function (v, viewIndex) {
    var questionId = v.getAttribute('data-question-id');
    var respond = function (chosenIndex) {
      if (viewIndex !== idx) return; // stale view or already advanced
      advance({
        questionId: questionId,
        chosenIndex: chosenIndex,
        timeMs: Date.now() - questionStart
      });
    };
    v.querySelectorAll('.choice').forEach(function (btn) {
      btn.addEventListener('click', function () {
        respond(Number(btn.getAttribute('data-index')));
      });
    });
    var skip = v.querySelector('.skip-btn');
    if (skip) skip.addEventListener('click', function () { respond(null); });
  });

  function submit() {
    // Stop the countdown so only one submit happens.
    clearInterval(timerHandle);
    var form = document.createElement('form');
    form.method = 'post';
    form.action = '/tests/' + attemptId + '/submit';
    var input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'answers';
    input.value = JSON.stringify(answered);
    form.appendChild(input);
    document.body.appendChild(form);
    form.submit();
  }

  var timerHandle = setInterval(function () {
    var remaining = deadlineMs - Date.now();
    timerEl.textContent = fmt(remaining);
    if (remaining < 20000) timerLabel.textContent = 'Almost time';
    if (remaining <= 0) {
      // Time's up: flush the un-answered current question then submit.
      var v = views[idx];
      if (v) {
        answered.push({
          questionId: v.getAttribute('data-question-id'),
          chosenIndex: null,
          timeMs: Date.now() - questionStart
        });
      }
      submit();
    }
  }, 250);

  render();
})();
</script>
{% endblock %}