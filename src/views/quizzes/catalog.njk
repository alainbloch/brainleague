{% extends "layouts/base.njk" %}
{% from "components/page.njk" import heading, empty %}
{% from "components/home-graphics.njk" import graphic %}
{% import "components/forms.njk" as forms %}

{% block content %}
<div class="page-stack">
  {{ heading('Practice tests', 'Pick a challenge, find your rhythm, and give your personal best a little competition.', 'tests') }}

  {% if error %}
    {{ forms.alert(error, 'danger') }}
  {% endif %}

  {% if tests.length === 0 %}
    {{ empty('Your next challenge is on its way', 'Explore a few tips while we get the next rounds ready.', '/tutorials', 'Explore tips', 'tests') }}
  {% else %}
    <div class="card-grid">
      {% for test in tests %}
        <section class="{{ ui.cardClass }} challenge-card">
          {{ graphic("tests") }}
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="min-w-0">
              <h2 class="font-heading text-lg font-semibold text-ink">{{ test.name }}</h2>
              <p class="text-xs text-muted">by {{ test.publisher }}</p>
            </div>
            {% if test.noGoingBack %}
              <span class="{{ ui.badgeClass('info') }}">No going back</span>
            {% endif %}
          </div>
          <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
            <div>
              <dt class="text-xs text-muted">Questions</dt>
              <dd class="font-medium text-ink">{{ test.questionCount }}</dd>
            </div>
            <div>
              <dt class="text-xs text-muted">Time</dt>
              <dd class="font-medium text-ink">{{ (test.durationSeconds / 60) | round(0, 'floor') }} min</dd>
            </div>
          </dl>
          <div class="card-actions">
            <a href="/tests/{{ test.slug }}/take" class="{{ ui.buttonClass('primary', 'md') }}">Start test →</a>
            <div class="flex flex-wrap justify-center gap-4 text-sm">
              <a href="/tests/{{ test.slug }}/leaderboard" class="py-2 underline underline-offset-4">Leaderboard</a>
              <a href="/tests/{{ test.slug }}/leaderboard/friends" class="py-2 underline underline-offset-4">Friends</a>
            </div>
          </div>
        </section>
      {% endfor %}
    </div>
  {% endif %}
</div>
{% endblock %}