{% extends "layouts/base.njk" %}

{% set answeredCorrect = report.correctCount %}
{% set reached = report.reachedCount %}
{% set total = report.questionCount %}
{% set skipFlagged = report.questions | selectattr('shouldHaveSkipped') | list %}

{% block content %}
<div class="page-stack">
  <div>
    <h1 class="page-title font-heading text-2xl font-semibold text-ink">{{ report.test.name }}</h1>
    <p class="text-sm text-muted">by {{ report.test.publisher }}</p>
  </div>

  {% if report.timedOut %}
    <div class="{{ ui.alertClass('warn') }}">Time ran out. Answers still within the test budget were credited; the rest were graded as unreached.</div>
  {% endif %}

  {# Summary highlights #}
  <section class="{{ ui.cardClass }} result-summary">
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div class="result-stat">
        <p class="text-xs text-muted">Correct</p>
        <p class="font-heading text-2xl font-semibold text-ok">{{ report.correctCount }}<span class="text-sm text-muted font-normal"> / {{ report.questionCount }}</span></p>
      </div>
      <div class="result-stat">
        <p class="text-xs text-muted">Reached</p>
        <p class="font-heading text-2xl font-semibold text-ink">{{ report.reachedCount }}<span class="text-sm text-muted font-normal"> / {{ total }}</span></p>
      </div>
      <div class="result-stat">
        <p class="text-xs text-muted">Accuracy</p>
        <p class="font-heading text-2xl font-semibold text-ink">{{ accuracy }}%</p>
        <p class="text-xs text-muted">of answered questions</p>
      </div>
      <div class="result-stat">
        <p class="text-xs text-muted">Avg per question</p>
        <p class="font-heading text-2xl font-semibold text-ink">{{ avgSecondsPerQuestion | round(1) }}s</p>
        <p class="text-xs text-muted">across reached questions</p>
      </div>
    </div>
  </section>

  {% if report.questions.length %}
    <section class="{{ ui.cardClass }}">
      <h2 class="text-xl font-semibold">Correct by question type</h2>
      <p class="text-sm text-muted mt-2">Correct answers out of the questions in this review, including skipped and unreached questions.</p>
      <div class="mt-5 grid gap-5">
        {% for category in ui.categoryResults(report.questions) %}
          <div>
            <div class="flex justify-between gap-3 mb-2"><span>{{ category.slug | replace('-', ' ') }}</span><span class="font-semibold">{{ category.correct }}/{{ category.total }}</span></div>
            <progress class="quiz-progress" value="{{ category.correct }}" max="{{ category.total }}" aria-label="{{ category.slug | replace('-', ' ') }}: {{ category.correct }} correct out of {{ category.total }}"></progress>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <section class="{{ ui.cardClass }}">
    <h2 class="text-xl font-semibold">Keep the momentum going</h2>
    <p class="page-description">Every round gives you something to build on. Review a method, then come back for a fresh challenge.</p>
    <div class="mt-5 flex flex-wrap gap-3">
      {% if skipFlagged.length %}
        <a href="/tutorials?category={{ skipFlagged[0].categorySlug }}" class="{{ ui.buttonClass('primary', 'md') }}">Practice {{ skipFlagged[0].categorySlug | replace('-', ' ') }} →</a>
      {% else %}
        <a href="/tests" class="{{ ui.buttonClass('primary', 'md') }}">Choose your next challenge →</a>
      {% endif %}
    </div>
  </section>

  {# Coaching signal: questions where too much time was spent for nothing. #}
  {% if skipFlagged.length %}
    <section class="{{ ui.cardClass }}">
      <div class="flex items-center gap-2">
        <h2 class="font-heading text-lg font-semibold text-ink mb-1">Find your rhythm</h2>
        <span class="{{ ui.badgeClass('warn') }}">{{ skipFlagged.length }}</span>
      </div>
      <p class="text-sm text-muted mb-4">These questions took a little longer. Try the tips below, then practice spotting when to move on and save time for your strengths.</p>
      <div class="grid gap-3">
        {% for q in skipFlagged %}
          <div class="rounded-md border border-edge bg-fill p-4">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <p class="text-sm font-medium text-ink">Q{{ q.index + 1 }} · {{ q.prompt }}</p>
              <span class="shrink-0 {{ ui.badgeClass('warn') }}">{{ (q.timeMs / 1000) | round(1) }}s spent</span>
            </div>
            <p class="mt-1 text-xs text-muted">Expected ~{{ q.estSeconds }}s. The answer was {{ q.choices[q.correctIndex] }}.</p>
            <a href="/tutorials?category={{ q.categorySlug }}" class="mt-1 inline-block text-xs font-medium text-accent underline-offset-4 hover:underline">How to handle {{ q.categorySlug | replace('-', ' ') }} →</a>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {# Per-question replay #}
  <section class="{{ ui.cardClass }}">
    <h2 class="font-heading text-lg font-semibold text-ink mb-4">Question review</h2>
    <ol class="grid gap-3">
      {% for q in report.questions %}
        {% set qNum = loop.index %}
        <li class="review-item">
          <div class="flex flex-wrap items-start justify-between gap-2">
            <p class="text-sm font-medium text-ink">Q{{ q.index + 1 }} · <a href="/tutorials?category={{ q.categorySlug }}" class="text-accent underline-offset-4 hover:underline">{{ q.categorySlug | replace('-', ' ') }}</a></p>
            <div class="flex items-center gap-2">
              {% if q.isCorrect == 1 %}
                <span class="{{ ui.badgeClass('ok') }}">Correct</span>
              {% elif q.chosenIndex is none %}
                <span class="{{ ui.badgeClass('neutral') }}">Skipped</span>
              {% else %}
                <span class="{{ ui.badgeClass('danger') }}">Incorrect</span>
              {% endif %}
              <span class="text-xs text-muted tabular-nums">{{ (q.timeMs / 1000) | round(1) }}s</span>
            </div>
          </div>
          <p class="mt-2 text-sm text-ink">{{ q.prompt }}</p>
          <ul class="mt-2 grid gap-1 text-sm">
            {% for choice in q.choices %}
              {% if choice == q.choices[q.correctIndex] %}
                <li class="text-ok">&#10003; {{ choice }} <span class="text-xs text-muted">(correct)</span></li>
              {% elif loop.index0 == q.chosenIndex %}
                <li class="text-danger">&#10007; {{ choice }} <span class="text-xs text-muted">(your answer)</span></li>
              {% else %}
                <li class="text-muted">{{ choice }}</li>
              {% endif %}
            {% endfor %}
          </ul>
          {% if q.explanation %}
            <p class="review-explanation mt-4 text-sm"><strong>Why:</strong> {{ q.explanation }}</p>
          {% endif %}
          <p class="mt-2 text-xs text-muted">Expected ~{{ q.estSeconds }}s</p>
        </li>
      {% endfor %}
    </ol>
  </section>

  <div class="flex flex-wrap gap-3">
    <a href="/tutorials" class="{{ ui.buttonClass('secondary', 'md') }}">Build your skills</a>
    <a href="/tests" class="{{ ui.buttonClass('primary', 'md') }}">Back to tests</a>
  </div>
</div>
{% endblock %}