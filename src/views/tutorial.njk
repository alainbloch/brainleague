{% extends "layouts/base.njk" %}

{% block content %}
<div class="mx-auto max-w-3xl grid gap-6">
  <p class="text-sm text-muted">
    <a href="/tutorials" class="underline-offset-4 hover:underline">← All tutorials</a>
  </p>
  <article class="grid gap-4">
    <header class="grid gap-1">
      <span class="text-xs uppercase tracking-wide text-muted">{{ tutorial.categorySlug | replace('-', ' ') }}</span>
      <h1 class="page-title font-heading text-2xl font-semibold text-ink">{{ tutorial.title }}</h1>
    </header>
    {% for section in ui.tutorialSections(tutorial.body) %}
      {% if section.tone == 'answer' %}
        <details class="learning-section learning-tip">
          <summary>{{ section.title }}</summary>
          <p>{{ section.text }}</p>
        </details>
      {% else %}
        <section class="learning-section learning-{{ section.tone }}">
          <h2>{{ section.title }}</h2>
          <p>{{ section.text }}</p>
        </section>
      {% endif %}
    {% endfor %}
    <a href="/tests" class="{{ ui.buttonClass('primary', 'md') }}">Try a practice test →</a>
  </article>
</div>
{% endblock %}