{% extends "layouts/base.njk" %}

{% block content %}
<div class="mx-auto max-w-3xl grid gap-6">
  <p class="text-sm text-muted">
    <a href="/tutorials" class="underline-offset-4 hover:underline">← All tutorials</a>
  </p>
  <article class="grid gap-4">
    <header class="grid gap-1">
      <span class="text-xs uppercase tracking-wide text-muted">{{ tutorial.categorySlug }}</span>
      <h1 class="font-heading text-2xl font-semibold text-ink">{{ tutorial.title }}</h1>
    </header>
    <div class="rounded-lg border border-edge bg-surface p-6 text-sm leading-relaxed text-ink-soft prose prose-sm">
      {{ tutorial.body | escape | replace('\n', '<br />') | safe }}
    </div>
    <a href="/tests" class="{{ ui.buttonClass('primary', 'md') }}">Try a practice test →</a>
  </article>
</div>
{% endblock %}