{% extends "layouts/base.njk" %}
{% import "components/forms.njk" as forms %}

{% block content %}
<div class="grid gap-6">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div class="grid gap-1">
      <h1 class="font-heading text-2xl font-semibold text-ink">Manage categories</h1>
      <p class="text-sm text-muted">Question categories classify the bank and tag tutorials.</p>
    </div>
    <a href="/admin/categories/new"><button type="button" class="{{ ui.buttonClass('primary', 'md') }}">New category</button></a>
  </header>

  {% if notice %}<div class="mb-4">{{ forms.alert(notice, "ok") }}</div>{% endif %}
  {% if error %}<div class="mb-4">{{ forms.alert(error, "danger") }}</div>{% endif %}

  <section class="overflow-x-auto rounded-lg border border-edge bg-surface p-2">
    <table class="w-full min-w-[32rem] border-collapse text-sm">
      <thead>
        <tr class="text-left text-xs uppercase text-muted">
          <th class="px-3 py-2 font-medium">Slug</th>
          <th class="px-3 py-2 font-medium">Name</th>
          <th class="px-3 py-2 font-medium text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for c in categories %}
          <tr class="border-t border-edge hover:bg-fill">
            <td class="px-3 py-2.5 font-mono text-ink">{{ c.slug }}</td>
            <td class="px-3 py-2.5 text-ink">{{ c.name }}</td>
            <td class="px-3 py-2.5">
              <div class="flex items-center justify-end gap-2">
                <a href="/admin/categories/{{ c.slug }}/edit"><button type="button" class="{{ ui.buttonClass('secondary', 'sm') }}">Edit</button></a>
                <form method="post" action="/admin/categories/{{ c.slug }}/delete"
                  onsubmit="return confirm('Delete {{ c.name | e }}? This fails if it is still in use.');">
                  <button type="submit" class="{{ ui.buttonClass('danger', 'sm') }}">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="3" class="px-3 py-8 text-center text-muted">No categories yet.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
</div>
{% endblock %}