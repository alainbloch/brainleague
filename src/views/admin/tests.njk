{% extends "layouts/base.njk" %}
{% import "components/forms.njk" as forms %}

{% block content %}
<div class="grid gap-6">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div class="grid gap-1">
      <h1 class="page-title font-heading text-2xl font-semibold text-ink">Manage tests</h1>
      <p class="text-sm text-muted">{{ tests.length }} test types in the catalog</p>
    </div>
    <a href="/admin/tests/new" class="{{ ui.buttonClass('primary', 'md') }}">New test</a>
  </header>

  {% if notice %}<div class="mb-4">{{ forms.alert(notice, "ok") }}</div>{% endif %}

  <section class="table-frame p-2" tabindex="0" aria-label="Scrollable records">
    <table class="w-full min-w-[44rem] border-collapse text-sm">
      <thead>
        <tr class="text-left text-xs uppercase text-muted">
          <th class="px-3 py-2 font-medium">Test</th>
          <th class="px-3 py-2 font-medium">Slug</th>
          <th class="px-3 py-2 font-medium">Publisher</th>
          <th class="px-3 py-2 font-medium">Questions</th>
          <th class="px-3 py-2 font-medium">Duration</th>
          <th class="px-3 py-2 font-medium text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for t in tests %}
          <tr class="border-t border-edge hover:bg-fill">
            <td class="px-3 py-2.5 font-medium text-ink">{{ t.name }}</td>
            <td class="px-3 py-2.5 text-muted">{{ t.slug }}</td>
            <td class="px-3 py-2.5 text-muted">{{ t.publisher }}</td>
            <td class="px-3 py-2.5">{{ t.questionCount }}</td>
            <td class="px-3 py-2.5 text-muted">{{ (t.durationSeconds / 60) }} min</td>
            <td class="px-3 py-2.5">
              <div class="flex items-center justify-end gap-2">
                <a href="/admin/tests/{{ t.id }}/edit" class="{{ ui.buttonClass('secondary', 'sm') }}">Edit</a>
                <form method="post" action="/admin/tests/{{ t.id }}/delete"
                  onsubmit="return confirm('Delete {{ t.name | e }}? This fails if it still has questions.');">
                  <button type="submit" class="{{ ui.buttonClass('danger', 'sm') }}">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="6" class="px-3 py-8 text-center text-muted">No test types yet.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
</div>
{% endblock %}