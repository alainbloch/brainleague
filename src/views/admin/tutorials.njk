{% extends "layouts/base.njk" %}
{% import "components/forms.njk" as forms %}

{% block content %}
<div class="grid gap-6">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div class="grid gap-1">
      <h1 class="font-heading text-2xl font-semibold text-ink">Manage tutorials</h1>
      <p class="text-sm text-muted">{{ tutorials.length }} tutorials</p>
    </div>
    <a href="/admin/tutorials/new"><button type="button" class="{{ ui.buttonClass('primary', 'md') }}">New tutorial</button></a>
  </header>

  {% if notice %}<div class="mb-4">{{ forms.alert(notice, "ok") }}</div>{% endif %}

  <section class="overflow-x-auto rounded-lg border border-edge bg-surface p-2">
    <table class="w-full min-w-[40rem] border-collapse text-sm">
      <thead>
        <tr class="text-left text-xs uppercase text-muted">
          <th class="px-3 py-2 font-medium">Title</th>
          <th class="px-3 py-2 font-medium">Category</th>
          <th class="px-3 py-2 font-medium">Slug</th>
          <th class="px-3 py-2 font-medium text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for item in tutorials %}
          <tr class="border-t border-edge hover:bg-fill">
            <td class="px-3 py-2.5 font-medium text-ink">{{ item.title }}</td>
            <td class="px-3 py-2.5 text-muted">{{ categoryName(item.categorySlug) }}</td>
            <td class="px-3 py-2.5 font-mono text-muted">{{ item.slug }}</td>
            <td class="px-3 py-2.5">
              <div class="flex items-center justify-end gap-2">
                <a href="/tutorials/{{ item.slug }}" class="text-sm text-ink-soft underline-offset-4 hover:underline">View</a>
                <a href="/admin/tutorials/{{ item.id }}/edit"><button type="button" class="{{ ui.buttonClass('secondary', 'sm') }}">Edit</button></a>
                <form method="post" action="/admin/tutorials/{{ item.id }}/delete" onsubmit="return confirm('Delete this tutorial?');">
                  <button type="submit" class="{{ ui.buttonClass('danger', 'sm') }}">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="4" class="px-3 py-8 text-center text-muted">No tutorials yet.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
</div>
{% endblock %}