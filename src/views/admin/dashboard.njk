{% extends "layouts/base.njk" %}

{% block content %}
<div class="grid gap-6">
  <header class="grid gap-1">
    <h1 class="page-title font-heading text-2xl font-semibold text-ink">Admin</h1>
    <p class="text-sm text-muted">Manage the accounts on this instance.</p>
  </header>

  <div class="grid gap-3 sm:grid-cols-3">
    <section class="{{ ui.cardClass }}">
      <p class="text-xs text-muted">Total users</p>
      <p class="font-heading text-2xl font-semibold text-ink">{{ stats.users }}</p>
    </section>
    <section class="{{ ui.cardClass }}">
      <p class="text-xs text-muted">Administrators</p>
      <p class="font-heading text-2xl font-semibold text-ink">{{ stats.admins }}</p>
    </section>
    <section class="{{ ui.cardClass }}">
      <p class="text-xs text-muted">Pending friend requests</p>
      <p class="font-heading text-2xl font-semibold text-ink">{{ user.adminPending or 0 }}</p>
    </section>
  </div>

  <div class="flex flex-wrap gap-3">
    <a href="/admin/users" class="{{ ui.buttonClass('primary', 'md') }}">Manage users</a>
    <a href="/admin/broadcast" class="{{ ui.buttonClass('secondary', 'md') }}">Broadcast notification</a>
    <a href="/users" class="{{ ui.buttonClass('secondary', 'md') }}">Browse directory</a>
  </div>

  <header class="mt-2 grid gap-1">
    <h2 class="font-heading text-lg font-semibold text-ink">Content</h2>
    <p class="text-sm text-muted">Manage the timed-test catalog and tutorials.</p>
  </header>
  <div class="flex flex-wrap gap-3">
    <a href="/admin/tests" class="{{ ui.buttonClass('primary', 'md') }}">Manage tests</a>
    <a href="/admin/questions" class="{{ ui.buttonClass('secondary', 'md') }}">Manage questions</a>
    <a href="/admin/categories" class="{{ ui.buttonClass('secondary', 'md') }}">Manage categories</a>
    <a href="/admin/tutorials" class="{{ ui.buttonClass('secondary', 'md') }}">Manage tutorials</a>
  </div>
</div>
{% endblock %}
