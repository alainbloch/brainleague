{% extends "layouts/base.njk" %}
{% import "components/forms.njk" as forms %}

{% block content %}
<div class="grid gap-6">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div class="grid gap-1">
      <h1 class="page-title font-heading text-2xl font-semibold text-ink">Manage questions</h1>
      <p class="text-sm text-muted">{{ data.total }} questions across the catalog</p>
    </div>
    <a href="/admin/questions/new" class="{{ ui.buttonClass('primary', 'md') }}">New question</a>
  </header>

  {% if notice %}<div class="mb-4">{{ forms.alert(notice, "ok") }}</div>{% endif %}

  <form method="get" action="/admin/questions" class="flex flex-wrap items-end gap-3">
    <label class="grid gap-1 text-sm">
      <span class="text-muted">Test type</span>
      <select name="testType" class="{{ ui.inputClass }}">
        <option value="">All tests</option>
        {% for t in tests %}
          <option value="{{ t.id }}" {% if filters.testType === t.id %}selected{% endif %}>{{ t.name }}</option>
        {% endfor %}
      </select>
    </label>
    <label class="grid gap-1 text-sm">
      <span class="text-muted">Category</span>
      <select name="category" class="{{ ui.inputClass }}">
        <option value="">All categories</option>
        {% for c in categories %}
          <option value="{{ c.slug }}" {% if filters.category === c.slug %}selected{% endif %}>{{ c.name }}</option>
        {% endfor %}
      </select>
    </label>
    <label class="grid gap-1 text-sm">
      <span class="text-muted">Search</span>
      <input type="text" name="q" value="{{ filters.q }}" class="{{ ui.inputClass }}" placeholder="Search prompts…" />
    </label>
    <button type="submit" class="{{ ui.buttonClass('secondary', 'md') }}">Filter</button>
  </form>

  <section class="table-frame p-2" tabindex="0" aria-label="Scrollable records">
    <table class="w-full min-w-[48rem] border-collapse text-sm">
      <thead>
        <tr class="text-left text-xs uppercase text-muted">
          <th class="px-3 py-2 font-medium">Prompt</th>
          <th class="px-3 py-2 font-medium">Test / Category</th>
          <th class="px-3 py-2 font-medium">Correct</th>
          <th class="px-3 py-2 font-medium">est seconds</th>
          <th class="px-3 py-2 font-medium text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for q in data.rows %}
          <tr class="border-t border-edge hover:bg-fill">
            <td class="max-w-md px-3 py-2.5 text-ink">{{ q.prompt | truncate(90) }}</td>
            <td class="px-3 py-2.5 text-muted">
              {% for t in tests %}{% if t.id === q.testTypeId %}{{ t.name }}{% endif %}{% endfor %}<br />
              {% for c in categories %}{% if c.slug === q.categorySlug %}{{ c.name }}{% endif %}{% endfor %}
            </td>
            <td class="px-3 py-2.5 text-ink">{{ q.choices[q.correctIndex] | default('—') | truncate(24) }}</td>
            <td class="px-3 py-2.5">{{ q.estSeconds }}</td>
            <td class="px-3 py-2.5">
              <div class="flex items-center justify-end gap-2">
                <a href="/admin/questions/{{ q.id }}/edit" class="{{ ui.buttonClass('secondary', 'sm') }}">Edit</a>
                <form method="post" action="/admin/questions/{{ q.id }}/delete" onsubmit="return confirm('Delete this question?');">
                  <button type="submit" class="{{ ui.buttonClass('danger', 'sm') }}">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="5" class="px-3 py-8 text-center text-muted">No questions match.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  {% if data.pages > 1 %}
    <nav class="flex items-center gap-2 text-sm" aria-label="Pagination">
      {% if data.page > 1 %}
        <a href="/admin/questions?page={{ data.page - 1 }}&q={{ filters.q }}&testType={{ filters.testType }}&category={{ filters.category }}" class="{{ ui.buttonClass('secondary', 'sm') }}">Previous</a>
      {% endif %}
      <span class="text-muted">Page {{ data.page }} of {{ data.pages }}</span>
      {% if data.page < data.pages %}
        <a href="/admin/questions?page={{ data.page + 1 }}&q={{ filters.q }}&testType={{ filters.testType }}&category={{ filters.category }}" class="{{ ui.buttonClass('secondary', 'sm') }}">Next</a>
      {% endif %}
    </nav>
  {% endif %}
</div>
{% endblock %}