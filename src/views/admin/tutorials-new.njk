{% extends "layouts/base.njk" %}
{% import "components/forms.njk" as forms %}

{% block content %}
<div class="mx-auto max-w-3xl grid gap-6">
  <header class="grid gap-1">
    <h1 class="page-title font-heading text-2xl font-semibold text-ink">New tutorial</h1>
    <p class="text-sm text-muted">Tip / how-to for a question category, linked from result reports.</p>
  </header>

  {% if error %}<div class="mb-4">{{ forms.alert(error, "danger") }}</div>{% endif %}

  <section class="{{ ui.cardClass }}">
    <form method="post" action="/admin/tutorials" class="grid gap-4">
      <label class="grid gap-1 text-sm">
        <span class="text-ink-soft">Category</span>
        <select name="categorySlug" class="{{ ui.inputClass }}" required>
          <option value="" disabled {% if not values.categorySlug %}selected{% endif %}>Choose a category…</option>
          {% for c in categories %}
            <option value="{{ c.slug }}" {% if values.categorySlug === c.slug %}selected{% endif %}>{{ c.name }}</option>
          {% endfor %}
        </select>
      </label>
      {{ forms.field("slug", "Slug", { value: values.slug, required: true, hint: "URL-friendly, e.g. figure-series-tips." }) }}
      {{ forms.field("title", "Title", { value: values.title, required: true }) }}
      {{ forms.field("body", "Body", { as: "textarea", rows: 8, value: values.body, required: true, hint: "Markdown or plain text." }) }}
      {{ forms.field("sortOrder", "Sort order", { type: "number", value: values.sortOrder, hint: "Lower sorts first." }) }}
      <div class="flex flex-wrap items-center justify-between gap-4">
        <a href="/admin/tutorials" class="text-sm text-ink-soft underline-offset-4 hover:underline">← Back to tutorials</a>
        <button type="submit" class="{{ ui.buttonClass('primary', 'md') }}">Create tutorial</button>
      </div>
    </form>
  </section>
</div>
{% endblock %}